# ==============================================================================
# MoodAlbum Production Environment Variables
# Copy to .env on your server: cp .env.example .env
# ==============================================================================

# Your public domain for automatic HTTPS via Let's Encrypt (e.g. moodalbum.com)
DOMAIN=your-domain.com

# PostgreSQL database credentials
POSTGRES_DB=moodalbum
POSTGRES_USER=moodalbum_user
POSTGRES_PASSWORD=generate_a_strong_password_here
